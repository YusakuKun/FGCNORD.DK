# Google Calendar API credentials
# Kopier denne fil til .env og udfyld dine egne værdier.
# Du kan oprette en API key i Google Cloud Console: https://console.cloud.google.com/
# Kalenderen skal være offentligt delt for at API'et kan læse den.
VITE_GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
VITE_GOOGLE_CALENDAR_API_KEY=your-api-key

# Clerk authentication (til Discord login på /bliv-medlem)
# Opret en gratis konto på https://clerk.com, opret en application,
# og aktivér Discord som social provider. Find publishable key under API keys.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
